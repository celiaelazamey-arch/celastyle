{
  "name": "celastyle",
  "version": "0.1.0",
  "private": true,
  "description": "CelaStyle — a design system for command-center interfaces",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@celastyle/command-center",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules packages/*/dist apps/*/.next",
    "recover": "./scripts/recover.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
