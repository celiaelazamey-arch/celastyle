# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
.test-build/
.test-build-workspace/

# Environment
.env
.env*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Test / tooling caches
coverage/
.nyc_output/
.turbo/
.cache/

# Arena
.arena/

# Verification build output — kept separate so a gate build never corrupts a
# running dev server (see apps/command-center/next.config.mjs).
apps/command-center/.next-verify/

# Runtime evidence store. Written by the agent session and appended to on
every run; committing it would put an ever-growing hash chain in the history
# and make the working tree dirty for reasons unrelated to any change.
apps/command-center/.runtime/
